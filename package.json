{
  "name": "railbot",
  "version": "0.1.0",
  "description": "AI bots that work inside a scope you set, gated by code checks, a second AI, and you.",
  "license": "MIT",
  "author": "jessejames1125",
  "type": "module",
  "bin": {
    "railbot": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./github": "./src/github.js",
    "./package.json": "./package.json",
    "./bots/*": "./src/bots/*"
  },
  "files": [
    "src/",
    "templates/",
    "evals/sim/*.mjs",
    "evals/sim/results/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec \"test/*.test.js\""
  },
  "keywords": [
    "ai-agents",
    "bots",
    "human-in-the-loop",
    "claude",
    "github-bot",
    "guardrails",
    "audit-log"
  ]
}
